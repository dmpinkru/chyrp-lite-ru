#: modules/migrator/info.php:3
msgid "Migration Assistant"
msgstr "Помощник миграции"

#: modules/migrator/info.php:6
msgid "Enables import from Wordpress, MovableType, TextPattern, and Tumblr."
msgstr ""
"Позволяет импортировать данные из WordPress, MovableType, TextPattern и "
"Tumblr."

#: modules/migrator/migrator.php:20
msgid "Migration"
msgstr "Миграция"

#: modules/migrator/migrator.php:38 modules/migrator/migrator.php:265
#: modules/migrator/migrator.php:445 modules/migrator/migrator.php:619
msgid "You do not have sufficient privileges to import content."
msgstr "У вас недостаточно прав для импорта контента."

#: modules/migrator/migrator.php:52 modules/migrator/migrator.php:284
#: modules/migrator/migrator.php:459 modules/migrator/migrator.php:633
msgid "Missing Feather"
msgstr "Отсутствует перо"

#: modules/migrator/migrator.php:53
msgid "Text feather must be enabled to import from WordPress."
msgstr "Для импорта из WordPress должно быть включено текстовое перо."

#: modules/migrator/migrator.php:60
msgid "You must select a WordPress export file."
msgstr "Вы должны выбрать файл экспорта WordPress."

#: modules/migrator/migrator.php:132
msgid "The file does not seem to be a valid WordPress export file."
msgstr "Похоже, этот файл не является допустимым файлом экспорта WordPress."

#: modules/migrator/migrator.php:248
msgid "WordPress content successfully imported!"
msgstr "Контент WordPress успешно импортирован!"

#: modules/migrator/migrator.php:285
msgid ""
"Text, Photo, Quote, and Link feathers must be enabled to import from Tumblr."
msgstr ""
"Для импорта из Tumblr должны быть включены перья: Текст, Фото, Цитата и "
"Ссылка."

#: modules/migrator/migrator.php:292
msgid "Invalid URL."
msgstr "Недопустимый URL."

#: modules/migrator/migrator.php:310 modules/migrator/migrator.php:321
msgid "Could not retrieve content from the Tumblr URL."
msgstr "Не удалось получить контент по URL Tumblr."

#: modules/migrator/migrator.php:428
msgid "Tumblr content successfully imported!"
msgstr "Контент Tumblr успешно импортирован!"

#: modules/migrator/migrator.php:460
msgid "Text feather must be enabled to import from TextPattern."
msgstr "Для импорта из TextPattern должно быть включено текстовое перо."

#: modules/migrator/migrator.php:467 modules/migrator/migrator.php:641
msgid "MySQLi is required for database migration."
msgstr "Для миграции базы данных требуется MySQLi."

#: modules/migrator/migrator.php:474 modules/migrator/migrator.php:648
msgid "Host cannot be empty."
msgstr "Хост не может быть пустым."

#: modules/migrator/migrator.php:481 modules/migrator/migrator.php:655
msgid "Username cannot be empty."
msgstr "Имя пользователя не может быть пустым."

#: modules/migrator/migrator.php:488 modules/migrator/migrator.php:662
msgid "Password cannot be empty."
msgstr "Пароль не может быть пустым."

#: modules/migrator/migrator.php:495 modules/migrator/migrator.php:669
msgid "Database cannot be empty."
msgstr "База данных не может быть пустой."

#: modules/migrator/migrator.php:511
msgid "Could not connect to the TextPattern database."
msgstr "Не удалось подключиться к базе данных TextPattern."

#: modules/migrator/migrator.php:526 modules/migrator/migrator.php:697
msgid "Database Error"
msgstr "Ошибка базы данных"

#: modules/migrator/migrator.php:602
msgid "TextPattern content successfully imported!"
msgstr "Контент TextPattern успешно импортирован!"

#: modules/migrator/migrator.php:634
msgid "Text feather must be enabled to import from MovableType."
msgstr "Для импорта из MovableType должно быть включено текстовое перо."

#: modules/migrator/migrator.php:685
msgid "Could not connect to the MovableType database."
msgstr "Не удалось подключиться к базе данных MovableType."

#: modules/migrator/migrator.php:809
msgid "MovableType content successfully imported!"
msgstr "Контент MovableType успешно импортирован!"
