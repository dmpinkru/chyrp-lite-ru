msgid "Sitemap Settings"
msgstr "Настройки карты сайта"

#: modules/sitemap/admin/pages/sitemap_settings.twig:10
msgid "Sitemap Path"
msgstr "Путь к карте сайта"

#: modules/sitemap/admin/pages/sitemap_settings.twig:14
msgid "The directory to which the sitemap is written."
msgstr "Каталог, в который записывается карта сайта."

#: modules/sitemap/admin/pages/sitemap_settings.twig:18
msgid "Blog is Updated"
msgstr "Обновление блога"

#: modules/sitemap/admin/pages/sitemap_settings.twig:29
msgid "Pages are Edited"
msgstr "Редактирование страниц"

#: modules/sitemap/admin/pages/sitemap_settings.twig:40
msgid "Posts are Edited"
msgstr "Редактирование записей"

#: modules/sitemap/admin/pages/sitemap_settings.twig:52
msgid ""
"These values hint to search engines how frequently they should crawl your "
"site."
msgstr ""
"Эти значения подсказывают поисковым системам, как часто им следует "
"сканировать ваш сайт."

#: modules/sitemap/info.php:3
msgid "Sitemap Generator"
msgstr "Генератор карты сайта"

#: modules/sitemap/info.php:6
msgid ""
"Creates a <em>sitemap.xml</em> file on your server to help search engines "
"index your blog."
msgstr ""
"Создает файл <em>sitemap.xml</em> на вашем сервере, чтобы помочь поисковым "
"системам индексировать ваш блог."

#: modules/sitemap/sitemap.php:39
msgid "Sitemap"
msgstr "Карта сайта"

#: modules/sitemap/sitemap.php:59
msgid "Hourly"
msgstr "Каждый час"

#: modules/sitemap/sitemap.php:60
msgid "Daily"
msgstr "Ежедневно"

#: modules/sitemap/sitemap.php:61
msgid "Weekly"
msgstr "Еженедельно"

#: modules/sitemap/sitemap.php:62
msgid "Monthly"
msgstr "Ежемесячно"

#: modules/sitemap/sitemap.php:63
msgid "Yearly"
msgstr "Ежегодно"

#: modules/sitemap/sitemap.php:64
msgid "Never"
msgstr "Никогда"

#: modules/sitemap/sitemap.php:88
msgid "Could not determine the absolute path to the Sitemap."
msgstr "Не удалось определить абсолютный путь к карте сайта."
