msgid "Month created"
msgstr "Месяц создания"

#: admin/help/filtering_results.twig:21 admin/pages/route_settings.twig:50
msgid "(e.g. 12)"
msgstr "(например, 12)"

#: admin/help/filtering_results.twig:25 admin/pages/route_settings.twig:54
msgid "Day created"
msgstr "День создания"

#: admin/help/filtering_results.twig:25 admin/pages/route_settings.twig:54
msgid "(e.g. 25)"
msgstr "(например, 25)"

#: admin/help/filtering_results.twig:29 admin/pages/route_settings.twig:58
msgid "Hour created"
msgstr "Час создания"

#: admin/help/filtering_results.twig:29 admin/pages/route_settings.twig:58
msgid "(e.g. 03)"
msgstr "(например, 03)"

#: admin/help/filtering_results.twig:33 admin/pages/route_settings.twig:62
msgid "Minute created"
msgstr "Минута создания"

#: admin/help/filtering_results.twig:33 admin/pages/route_settings.twig:62
msgid "(e.g. 59)"
msgstr "(например, 59)"

#: admin/help/filtering_results.twig:37 admin/pages/route_settings.twig:66
msgid "Second created"
msgstr "Секунда создания"

#: admin/help/filtering_results.twig:37 admin/pages/route_settings.twig:66
msgid "(e.g. 30)"
msgstr "(например, 30)"

#: admin/help/filtering_results.twig:41
msgid "Created before (datetime)"
msgstr "Создано до (дата и время)"

#: admin/help/filtering_results.twig:45
msgid "Created after (datetime)"
msgstr "Создано после (дата и время)"

#: admin/help/filtering_results.twig:49 admin/pages/route_settings.twig:74
msgid "Author (login)"
msgstr "Автор (логин)"

#: admin/help/filtering_results.twig:49 admin/pages/route_settings.twig:74
msgid "(e.g. Alex)"
msgstr "(например, Alex)"

#: admin/help/filtering_results.twig:53
msgid "Group name"
msgstr "Имя группы"

#: admin/help/filtering_results.twig:53
msgid "(e.g. Members)"
msgstr "(например, Members)"

#: admin/help/filtering_results.twig:57
msgid ""
"Use the syntax <code>ASC:column;</code> or <code>DESC:column;</code> to sort "
"the results in ascending or descending order. For example: <code>DESC:"
"user_id;ASC:id;</code> would sort a table of posts in descending order of "
"user ID and then ascending order of post ID."
msgstr ""
"Используйте синтаксис <code>ASC:столбец;</code> или <code>DESC:столбец;</"
"code> для сортировки результатов по возрастанию или убыванию. Например: "
"<code>DESC:user_id;ASC:id;</code> отсортирует таблицу записей по убыванию ID "
"пользователя, а затем по возрастанию ID записи."

#: admin/help/filtering_results.twig:60
msgid ""
"Use the SQL wildcards <code>_</code> and <code>%</code> to substitute one or "
"multiple characters in a search term. To include these characters literally, "
"prefix <code>|</code> as an escape character."
msgstr ""
"Используйте SQL-символы <code>_</code> и <code>%</code> для замены одного "
"или нескольких символов в поисковом запросе. Чтобы использовать эти символы "
"буквально, добавьте префикс <code>|</code> в качестве экранирующего символа."

